# Copy to .env (which is gitignored) and fill in. `chmod 600 .env`.
# On Vercel these go in Project Settings -> Environment Variables instead.

# Required. From https://play.cartesia.ai/keys
CARTESIA_KEY=sk_car_...

# Optional. Leave unset for the event station on your own machine.
# Set it on any deployment reachable from the internet: /api/token mints tokens
# that spend real money against the key above, so an open one is an open tab.
# STATION_PASSCODE=some-words-only-your-table-knows
